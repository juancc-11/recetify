# =====================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - PLANTILLA
# =====================================================
#
# IMPORTANTE PARA USUARIOS CON GITHUB PÚBLICO:
# 1. Este archivo (.env.example) SÍ se puede hacer público (no contiene secretos)
# 2. El archivo .env (con credenciales reales) está en .gitignore
# 3. Para usar la app en tu máquina:
#    a) Copia este archivo: cp .env.example .env
#    b) Edita .env con tus credenciales reales
#    c) NUNCA hagas commit de .env
#
# =====================================================

# BASE DE DATOS - Aiven Cloud MySQL
# Obtén estos valores de tu dashboard de Aiven
DB_HOST=mysql-xxxxxxxxx-xxxxxxxx-xxxxx.g.aivencloud.com
DB_PORT=20497
DB_NAME=recetas_db
DB_USERNAME=avnadmin
DB_PASSWORD=tu-contraseña-secreta-aqui

# AMBIENTE DE APLICACIÓN
# Valores: dev (desarrollo), test (pruebas), prod (producción)
YII_ENV=dev

# DEBUG
# true = Mostrar errores detallados (desarrollo)
# false = Ocultar errores (producción)
YII_DEBUG=true